class Solution {
    public int secondLargestElement(int[] nums) {
        Integer first = null;
        Integer second = null;

        for (int n : nums) {
            if (n == first || n == second) continue;  

            if (first == null || n > first) {
                second = first;
                first = n;
            } else if (second == null || (n > second && n < first)) {
                second = n;
            }
        }

        return second == null ? -1 : second;
    }
}
